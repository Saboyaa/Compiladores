// Exemplo 7.4.1 do livro, reescrito para obedecer a gramatica:
//  - o corpo do while e um comando simples (um bloco exigiria uma declaracao);
//  - somaFat chama fatorial (o livro chama "fat", que nao esta declarado).

function fatorial(n: integer): integer
{
    var i, f: integer;
    i = 2;
    f = 1;
    while (i <= n)
        f = f * i++;
    return f;
}

function somaFat(n: integer): integer
{
    var i, s: integer;
    i = 0;
    s = 0;
    while (++i <= n)
        s = s + fatorial(i);
    return s;
}
